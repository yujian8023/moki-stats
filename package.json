{
  "name": "moki-stats",
  "version": "2.1.0",
  "description": "Moki Card 最强阵容统计 - 自动采集竞赛数据并分析高频卡牌（重构版 v2）",
  "type": "module",
  "scripts": {
    "init": "node src/fetch.js --all",
    "init:docs": "DATA_DIR=docs/data node src/fetch.js --all",
    "fetch": "node src/fetch.js --incremental",
    "fetch:docs": "DATA_DIR=docs/data node src/fetch.js --incremental",
    "fetch:all": "node src/fetch.js --all",
    "fetch:leaderboards": "node src/fetch.js --leaderboards",
    "stats": "tsx src/stats.js",
    "stats:docs": "DATA_DIR=docs/data tsx src/stats.js",
    "stats:filtered": "tsx src/stats.js --filter",
    "stats:today": "tsx src/stats.js --time-range today",
    "stats:week": "tsx src/stats.js --time-range last_7_days",
    "stats:prize": "tsx src/stats.js --with-prize-pool",
    "analyze": "node src/analyze.js",
    "analyze:docs": "DATA_DIR=docs/data node src/analyze.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "build": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "moki",
    "fantasy",
    "stats",
    "leaderboard",
    "deck-builder"
  ],
  "author": "Billions",
  "license": "MIT",
  "dependencies": {
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@types/node-fetch": "^2.6.13",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
